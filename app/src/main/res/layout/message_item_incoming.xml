<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="5dp">

    <!-- Profile Image -->
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/incoming_image_profile"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/person"
        android:layout_alignParentStart="true"/>

    <!-- Message Container -->
    <RelativeLayout
        android:id="@+id/message_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="47dp"
        android:background="@drawable/message_background">

    <!-- Message Text -->
    <TextView
        android:id="@+id/incoming_text_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sample Message"
        android:textSize="16sp"
        android:textColor="@android:color/black"
        android:padding="10dp"
        android:maxWidth="250dp"
        android:layout_alignParentStart="true"/>

    <!-- Name -->
    <TextView
        android:id="@+id/incoming_text_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="John Doe"
        android:textSize="14sp"
        android:textColor="@android:color/darker_gray"
        android:layout_below="@id/incoming_text_message"
        android:layout_marginStart="10dp"/>

    <!-- Timestamp -->
    <TextView
        android:id="@+id/incoming_text_timestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="12:34 PM"
        android:textSize="12sp"
        android:textColor="@android:color/darker_gray"
        android:layout_alignParentEnd="true"
        android:layout_alignBottom="@id/incoming_text_name"
        android:layout_marginEnd="10dp"/>

</RelativeLayout>

</RelativeLayout>
