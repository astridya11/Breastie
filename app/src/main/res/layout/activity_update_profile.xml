<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".UpdateProfile">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/baby_pink">

        <ImageView
            android:id="@+id/back_update_profile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="38dp"
            android:adjustViewBounds="true"
            android:background="@drawable/back"
            android:backgroundTint="@color/white"
            android:contentDescription="Back Button"
            android:scaleType="fitXY" />

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:background="@color/baby_pink"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
            app:title="User Profile"
            android:gravity="top"
            app:titleMarginStart="30dp" />

    </LinearLayout>


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"

        android:background="@color/white"
        android:padding="15dp">

        <TextView
            android:id="@+id/textView_update_profile_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:padding="6dp"
            android:text="Name"
            android:textColor="#555555"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/editText_update_profile_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/textView_update_profile_name"
            android:background="@drawable/border"
            android:hint="Enter username"
            android:inputType="textPersonName"
            android:padding="6dp"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/textView_update_profile_dob"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/editText_update_profile_name"
            android:layout_marginTop="30dp"
            android:padding="6dp"
            android:text="Date of Birth (dd/mm/yyyy)"
            android:textColor="#555555"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/editText_update_profile_dob"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/textView_update_profile_dob"
            android:background="@drawable/border"
            android:focusable="false"
            android:hint="YYYY/MM/DD"
            android:inputType="text"
            android:padding="6dp"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/textView_update_profile_gender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/editText_update_profile_dob"
            android:layout_marginTop="30dp"
            android:padding="6dp"
            android:text="Gender"
            android:textColor="#555555"
            android:textSize="16sp" />

        <RadioGroup
            android:id="@+id/radio_group_update_gender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/textView_update_profile_gender"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radio_male"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Male"
                android:textColor="#666666"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/radio_female"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Female"
                android:textColor="#666666"
                android:textSize="16sp" />
        </RadioGroup>

        <TextView
            android:id="@+id/textView_update_profile_mobile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/radio_group_update_gender"
            android:layout_marginTop="30dp"
            android:padding="6dp"
            android:text="Phone"
            android:textColor="#555555"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/editText_update_profile_mobile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/textView_update_profile_mobile"
            android:background="@drawable/border"
            android:hint="Enter your mobile no. (without +60)"
            android:inputType="phone"
            android:padding="6dp"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/textView_update_profile_country"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/editText_update_profile_mobile"
            android:layout_marginTop="30dp"
            android:padding="6dp"
            android:text="Country"
            android:textColor="#555555"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/editText_update_profile_country"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/textView_update_profile_country"
            android:background="@drawable/border"
            android:hint="eg. MALAYSIA"
            android:inputType="textCapCharacters"
            android:padding="6dp"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/textView_update_profile_stage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/editText_update_profile_country"
            android:layout_marginTop="30dp"
            android:padding="6dp"
            android:text="Stage"
            android:textColor="#555555"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/editText_update_profile_stage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/textView_update_profile_stage"
            android:background="@drawable/border"
            android:inputType="number"
            android:padding="6dp"
            android:textSize="16sp" />

        <Button
            android:id="@+id/button_upload_profile_pic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/editText_update_profile_stage"
            android:layout_marginLeft="70dp"
            android:layout_marginTop="30dp"
            android:layout_marginRight="70dp"
            android:text="Upload profile picture" />

        <Button
            android:id="@+id/button_update_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/button_upload_profile_pic"
            android:layout_marginLeft="70dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="70dp"
            android:text="Upload Profile" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:elevation="10dp"
            android:visibility="gone" />

    </RelativeLayout>


</RelativeLayout>